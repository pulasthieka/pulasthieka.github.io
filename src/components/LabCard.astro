---
import type { lab } from '../data/site';
interface Props {
  item: (typeof lab)[number];
  delay?: number;
}
const { item, delay = 0 } = Astro.props;
---
<a class="lab-card accent-plum" href={`/lab/${item.slug}/`} style={`animation-delay:${delay}ms`}>
  <div class="lab-card__stage" aria-hidden="true">
    {item.glyphs.map((g) => <span>{g}</span>)}
  </div>
  <div class="lab-card__body">
    <div class="card__meta mono">{item.date} · {item.kind} · Interactive</div>
    <div class="card__title">{item.title}</div>
    <div class="card__blurb">{item.summary}</div>
    <div class="card__cta mono">Open →</div>
  </div>
</a>
