---
import { postUrl, shortDate, type Post } from '../lib/posts';
interface Props {
  post: Post;
  delay?: number;
}
const { post, delay = 0 } = Astro.props;
---
<a class="card" href={postUrl(post)} style={`animation-delay:${delay}ms`}>
  <img class="card__cover" src={`/covers/${post.id}.svg`} alt="" width="1600" height="900" loading="lazy" />
  <div class="card__meta mono">
    {shortDate(post.data.date)}{post.data.category && ` · ${post.data.category}`}
  </div>
  <div class="card__title">{post.data.title}</div>
  <div class="card__blurb">{post.data.description}</div>
  <div class="card__cta mono">{post.data.draft ? 'Draft' : 'Read →'}</div>
</a>
