---
import Base from '../../layouts/Base.astro';
import { site, works } from '../../data/site';
---
<Base title="Design" description="UX and visual design — web apps, posters, pitch decks and interface studies.">
  <div class="panel page">
    <h1 class="hl hl--page">
      Design <span>› UX and visual work spanning web apps, posters, pitch decks and murals</span>
    </h1>
    <p class="lede">Outside research, I design. A selection is below; the rest is on Behance.</p>
    <div class="actions">
      <a class="btn btn--blue mono" href={site.links.behance} target="_blank" rel="noopener">Behance ↗</a>
      <a class="btn mono" href="/talks/">Talks &amp; decks</a>
    </div>

    <section class="sect">
      <h2>{works.length} projects</h2>
      <div class="works">
        {
          works.map((w, i) => {
            const external = !w.cta;
            return (
              <a class="work" href={w.href ?? site.links.behance} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                <div class="work__tile">
                  {w.img ? (
                    <img src={`/img/work/${w.img}`} alt="" width="808" height="632" loading={i < 3 ? 'eager' : 'lazy'} />
                  ) : (
                    <b aria-hidden="true">{w.mark}</b>
                  )}
                </div>
                <h2>{w.title}</h2>
                <p>{w.body}</p>
                <div class="meta mono">
                  <span>{w.kind}</span>
                  <span>{external ? 'Behance ↗' : 'Case study'}</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>
