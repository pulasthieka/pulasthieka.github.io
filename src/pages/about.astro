---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About" description="Pulasthi Ekanayake — a biomedical engineer working where engineering and design meet.">
  <div class="panel page">
    <div class="about">
      <div>
        <h1 class="hl hl--page">
          About <span>› Where biomedical engineering and design meet</span>
        </h1>
        <p class="lede">
          I'm Pulasthi — a biomedical engineer from Colombo, Sri Lanka. I've worked as a machine learning engineer
          building AI tools for scientists, and I'm now in Melbourne for a PhD, picking back up research I began during
          my undergrad into biosignal-based diagnostics.
        </p>
        <p class="lede">
          Alongside the engineering, I've spent years working in UX and visual design — from web apps to posters and
          pitch decks. I'm especially drawn to where biomedical engineering and design meet: making complex health
          technology genuinely usable.
        </p>
        <div class="actions">
          <a class="btn btn--blue mono" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn mono" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn mono" href={site.links.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn mono" href={site.links.behance} target="_blank" rel="noopener">Behance ↗</a>
        </div>
      </div>
      <figure class="portrait">
        <img src="/img/portrait.svg" alt="Portrait of Pulasthi Ekanayake, drawn as stacked line traces" width="800" height="1000" />
      </figure>
    </div>

    <div class="split">
      <section class="sect">
        <h2>Research <a href="/research/">Highlights and record</a></h2>
        <ul class="list">
          <li><span>Biosignal acquisition and diagnostics, and deep learning for mass spectrometry and biomedical imaging.</span></li>
        </ul>
      </section>
      <section class="sect">
        <h2>Design <a href="/creative/">Projects</a></h2>
        <ul class="list">
          <li><span>Web apps, posters, pitch decks and interface studies, with the full set on Behance.</span></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
