---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About" accent="green" description="Pulasthi Ekanayake — a biomedical engineer working where engineering and design meet.">
  <section class="page page--mid">
    <div class="about">
      <div>
        <div class="eyebrow mono">About me</div>
        <h1 class="display" style="font-size:clamp(28px,4.4vw,48px);line-height:1.08">
          Where biomedical engineering and <em>design</em> meet.
        </h1>
        <p class="lede" style="font-size:clamp(17px,1.7vw,20px);line-height:1.65">
          I'm Pulasthi — a biomedical engineer from Colombo, Sri Lanka. I've worked as a machine learning engineer
          building AI tools for scientists, and I'm now in Melbourne for a PhD, picking back up research I began during
          my undergrad into biosignal-based diagnostics. Alongside the engineering, I've spent years working in UX and
          visual design — from web apps to posters and pitch decks. I'm especially drawn to where biomedical
          engineering and design meet: making complex health technology genuinely usable.
        </p>
        <div class="linkrow mono">
          <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={site.links.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={site.links.behance} target="_blank" rel="noopener">Behance ↗</a>
          <a href={`mailto:${site.email}`}>Email ↗</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/img/portrait.svg" alt="Portrait of Pulasthi Ekanayake, drawn as stacked line traces" width="800" height="1000" />
      </div>
    </div>

    <div class="next">
      <a class="accent-blue" href="/research/">
        <span class="mono">01</span>
        <b>Researcher →</b>
      </a>
      <a class="accent-rust" href="/creative/">
        <span class="mono">02</span>
        <b class="sans">Creative →</b>
      </a>
    </div>
  </section>
</Base>
