---
import Base from '../layouts/Base.astro';
import { site, highlights, timeline } from '../data/site';
import { getPosts, postUrl, dayDate, sectionOf, lengthOf } from '../lib/posts';

const posts = (await getPosts()).filter((p) => sectionOf(p) !== 'Notes').slice(0, 3);
---
<Base title="Research" description="Biosignals, diagnostics, and the models that read them — research highlights, education and writing.">
  <div class="panel page">
    <h1 class="hl hl--page">
      Research <span>› Biosignals, diagnostics, and the models that read them</span>
    </h1>
    <p class="lede">
      I'm a biomedical engineer (First Class Honours, University of Moratuwa) and a PhD candidate at the University of
      Melbourne. My research so far has centered on biosignal acquisition and diagnostics, with recent work applying
      deep learning to mass spectrometry and biomedical imaging.
    </p>
    <div class="actions">
      <a class="btn btn--blue mono" href="/blog/">Read the articles</a>
      <a class="btn mono" href={site.links.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a class="btn mono" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>

    <div class="split">
      <section class="sect">
        <h2>Highlights</h2>
        <ul class="list">
          {
            highlights.map((h) => (
              <li>
                <b>{h.title} · {h.meta}</b>
                <span>{h.sub} {h.body}</span>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="sect">
        <h2>Education &amp; experience</h2>
        <div style="margin-top:12px">
          {
            timeline.map((t) => (
              <div class="rec">
                <div class="mono">{t.when}</div>
                <div>
                  <b>{t.role}</b>
                  <span>{t.org}</span>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="sect">
      <h2>Recent writing <a href="/blog/">All articles</a></h2>
      <div class="cards3">
        {
          posts.map((p) => (
            <a href={postUrl(p)}>
              <img src={`/covers/${p.id}-thumb.svg`} alt="" width="1600" height="900" loading="lazy" />
              <div>
                <span class="chip mono">{sectionOf(p)}</span>
                <h3>{p.data.title}</h3>
                <div class="meta mono">
                  <time datetime={p.data.date.toISOString().slice(0, 10)}>{dayDate(p.data.date)}</time>
                  <span>{lengthOf(p)}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>
