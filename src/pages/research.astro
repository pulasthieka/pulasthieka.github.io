---
import Base from '../layouts/Base.astro';
import { site, highlights, timeline } from '../data/site';
import { getPosts, postUrl, sectionOf } from '../lib/posts';

const posts = (await getPosts()).filter((p) => sectionOf(p) !== 'Notes').slice(0, 3);
import Icon from '../components/Icon.astro';
import PostMeta from '../components/PostMeta.astro';
import Cover from '../components/Cover.astro';
---
<Base title="Research" description="Biosignals, diagnostics and the models that read them: research highlights, background and writing.">
  <div class="panel page">
    <h1 class="hl hl--page">
      Research <span>› Biosignals, diagnostics, and the models that read them</span>
    </h1>
    <p class="lede">
      I studied biomedical engineering at the University of Moratuwa (First Class Honours) and I'm now a PhD candidate
      at the University of Melbourne. Most of my research has been about recording biosignals and using them to
      diagnose things. Lately I've been applying deep learning to mass spectrometry and medical imaging.
    </p>
    <div class="actions">
      <a class="btn btn--blue mono ic" href="/blog/"><Icon name="book-open" />Read the articles</a>
      <a class="btn mono ic" href={site.links.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
      <a class="btn mono ic" href={site.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
    </div>

    <div class="split">
      <section class="sect">
        <h2><span class="ic"><Icon name="award" />Highlights</span></h2>
        <ul class="list">
          {
            highlights.map((h) => (
              <li>
                <b>{h.title} · {h.meta}</b>
                <span>{h.sub} {h.body}</span>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="sect">
        <h2><span class="ic"><Icon name="briefcase" />Where I've been</span></h2>
        <div style="margin-top:12px">
          {
            timeline.map((t) => (
              <div class="rec">
                <div class="mono">{t.when}</div>
                <div>
                  <b>{t.role}</b>
                  <span>{t.org}</span>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="sect">
      <h2><span class="ic"><Icon name="file-text" />Recent writing</span> <a href="/blog/">All articles</a></h2>
      <div class="cards3">
        {
          posts.map((p) => (
            <a href={postUrl(p)}>
              <Cover post={p} thumb lazy />
              <div>
                <span class="chip mono">{sectionOf(p)}</span>
                <h3>{p.data.title}</h3>
                <div class="meta mono">
                  <PostMeta post={p} />
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>
