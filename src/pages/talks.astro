---
import Base from '../layouts/Base.astro';
import { talks } from '../data/site';
---
<Base title="Talks" description="Slides from talks and workshops I've given over the years.">
  <div class="panel page">
    <h1 class="hl hl--page">
      Talks <span>› Slides from talks and workshops I've given over the years</span>
    </h1>
    <div style="margin-top:26px">
      {
        talks.map((t) => (
          <div class="talk">
            <h2>{t.title}</h2>
            <p>{t.body}</p>
            <iframe src={t.src} title={t.title} loading="lazy" allowfullscreen />
          </div>
        ))
      }
    </div>
  </div>
</Base>
