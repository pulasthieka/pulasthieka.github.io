---
import Base from '../layouts/Base.astro';
import { talks } from '../data/site';
---
<Base title="Talks" accent="rust" description="Presentations on various topics that I have given over the years.">
  <section class="page">
    <div class="eyebrow mono">Talks</div>
    <h1 class="display">Presentations I've given over the years.</h1>

    <div style="margin-top:clamp(30px,5vh,54px);border-top:1px solid var(--rule-strong)">
      {
        talks.map((t) => (
          <div class="talk">
            <h2>{t.title}</h2>
            <p>{t.body}</p>
            <iframe src={t.src} title={t.title} loading="lazy" allowfullscreen />
          </div>
        ))
      }
    </div>
  </section>
</Base>
