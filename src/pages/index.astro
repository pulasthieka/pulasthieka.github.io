---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getPosts, postUrl } from '../lib/posts';

const posts = await getPosts();
// Band under the fork: the newest interactive piece and the newest article.
const piece = posts.find((p) => p.data.interactive);
const latest = posts.find((p) => p !== piece);
---
<Base footer={false}>
  <div class="home">
    <section class="hero">
      <h1>Biomedical engineer<br /><em>&amp; occasional designer</em></h1>
      <p class="mono">{site.status}</p>
    </section>

    <div class="fork">
      <a class="path accent-blue" href="/research/">
        <div>
          <div class="path__num mono">01</div>
          <div class="path__name">Researcher</div>
          <div class="path__sub">PhD research, writing &amp; interactive explainers</div>
        </div>
        <div class="path__foot">
          <div class="path__thumb">
            <img src="/img/portrait-thumb.svg" alt="" width="800" height="1000" style="object-position:50% 30%" />
          </div>
          <span class="path__go mono">Read the research →</span>
        </div>
      </a>

      <a class="path accent-rust" href="/creative/">
        <div>
          <div class="path__num mono">02</div>
          <div class="path__name path__name--sans">Creative</div>
          <div class="path__sub">UX, photography &amp; art</div>
        </div>
        <div class="path__foot">
          <div class="path__thumb" aria-hidden="true">
            <svg viewBox="0 0 120 90" preserveAspectRatio="xMidYMid slice">
              <rect width="120" height="90" fill="var(--tile)"></rect>
              <circle cx="44" cy="48" r="26" fill="var(--rust)"></circle>
              <rect x="62" y="14" width="40" height="52" fill="none" stroke="var(--ink)" stroke-width="1.2"></rect>
              <path d="M10 76h100" stroke="var(--ink)" stroke-width="1.2"></path>
              <rect x="74" y="28" width="16" height="16" fill="var(--ink)"></rect>
            </svg>
          </div>
          <span class="path__go mono">Explore concepts →</span>
        </div>
      </a>
    </div>

    <div class="band">
      {
        latest && (
          <a class="accent-blue" href={postUrl(latest)}>
            <span class="band__k mono">Latest post</span>
            <span class="band__v">{latest.data.title}</span>
            <span class="band__go mono">Read →</span>
          </a>
        )
      }
      {
        piece && (
          <a class="accent-plum" href={postUrl(piece)}>
            <span class="band__k mono">Interactive</span>
            <span class="band__v">{piece.data.title}</span>
            <span class="band__go mono">Open →</span>
          </a>
        )
      }
    </div>
  </div>
</Base>
