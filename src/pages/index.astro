---
import Base from '../layouts/Base.astro';
import AuthorStrip from '../components/AuthorStrip.astro';
import { highlights, works } from '../data/site';
import { getPosts, postUrl, sectionOf } from '../lib/posts';

const posts = await getPosts();
const [lead, ...others] = posts;
const rail = others.slice(0, 4);
const notes = posts.filter((p) => sectionOf(p) === 'Notes').slice(0, 2);
const shown = works.filter((w) => w.img).slice(0, 4);
import Icon from '../components/Icon.astro';
import PostMeta from '../components/PostMeta.astro';
import Cover from '../components/Cover.astro';
import { Image } from 'astro:assets';
const workImages = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.webp', { eager: true });
const work = (file: string) => workImages[`../assets/work/${file}`].default;
---
<Base>
  {
    lead && (
      <div class="panel front">
        <a class="lead" href={postUrl(lead)}>
          <div class="chips mono">
            <span class="chip chip--k">{sectionOf(lead)}</span>
            {lead.data.tags.slice(0, 1).map((t) => <span class="chip">{t}</span>)}
          </div>
          <h1 class="hl">
            {lead.data.title} <span>› {lead.data.description}</span>
          </h1>
          <div class="meta mono">
            <PostMeta post={lead} />
          </div>
          <figure>
            <Cover post={lead} />
          </figure>
        </a>
        <div class="rail">
          {
            rail.map((p) => (
              <a href={postUrl(p)}>
                <div>
                  <span class="chip mono">{sectionOf(p)}</span>
                  <h2>{p.data.title}</h2>
                  <div class="meta mono">
                    <PostMeta post={p} />
                  </div>
                </div>
                <Cover post={p} thumb lazy />
              </a>
            ))
          }
        </div>
      </div>
    )
  }

  <div class="dept">
    <section>
      <h2><span class="ic"><Icon name="flask-conical" />Research</span> <a href="/research/">See all</a></h2>
      <ul class="list">
        {
          highlights.slice(0, 3).map((h) => (
            <li>
              <b>{h.title} · {h.meta}</b>
              <span>{h.sub}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h2><span class="ic"><Icon name="palette" />Design</span> <a href="/creative/">See all</a></h2>
      <div class="quad">
        {
          shown.map((w) => (
            <a href={w.href} target="_blank" rel="noopener">
              <Image src={work(w.img!)} alt={w.title} widths={[300, 600]} sizes="(max-width: 860px) 45vw, 200px" />
            </a>
          ))
        }
      </div>
    </section>
    <section>
      <h2><span class="ic"><Icon name="file-text" />Notes</span> <a href="/blog/">All articles</a></h2>
      <ul class="list">
        {
          notes.map((p) => (
            <li>
              <a href={postUrl(p)}>
                <b>{p.data.title}</b>
                <span>{p.data.description}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/talks/">
            <b>Talks &amp; slides</b>
            <span>Pulse oximeters, coming up with ideas, biomedical innovation and graphic design.</span>
          </a>
        </li>
      </ul>
    </section>
  </div>

  <AuthorStrip />
</Base>
