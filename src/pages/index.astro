---
import Base from '../layouts/Base.astro';
import AuthorStrip from '../components/AuthorStrip.astro';
import { highlights, works } from '../data/site';
import { getPosts, postUrl, dayDate, sectionOf, lengthOf } from '../lib/posts';

const posts = await getPosts();
const [lead, ...others] = posts;
const rail = others.slice(0, 4);
const notes = posts.filter((p) => sectionOf(p) === 'Notes').slice(0, 2);
const shown = works.filter((w) => w.img).slice(0, 4);
---
<Base>
  {
    lead && (
      <div class="panel front">
        <a class="lead" href={postUrl(lead)}>
          <div class="chips mono">
            <span class="chip chip--k">{sectionOf(lead)}</span>
            {lead.data.tags.slice(0, 1).map((t) => <span class="chip">{t}</span>)}
          </div>
          <h1 class="hl">
            {lead.data.title} <span>› {lead.data.description}</span>
          </h1>
          <div class="meta mono">
            <time datetime={lead.data.date.toISOString().slice(0, 10)}>{dayDate(lead.data.date)}</time>
            <span>{lengthOf(lead)}</span>
          </div>
          <figure>
            <img src={`/covers/${lead.id}.svg`} alt="" width="1600" height="900" />
          </figure>
        </a>
        <div class="rail">
          {
            rail.map((p) => (
              <a href={postUrl(p)}>
                <div>
                  <span class="chip mono">{sectionOf(p)}</span>
                  <h2>{p.data.title}</h2>
                  <div class="meta mono">
                    <time datetime={p.data.date.toISOString().slice(0, 10)}>{dayDate(p.data.date)}</time>
                    <span>{lengthOf(p)}</span>
                  </div>
                </div>
                <img src={`/covers/${p.id}-thumb.svg`} alt="" width="1600" height="900" loading="lazy" />
              </a>
            ))
          }
        </div>
      </div>
    )
  }

  <div class="dept">
    <section>
      <h2>Research <a href="/research/">All research</a></h2>
      <ul class="list">
        {
          highlights.slice(0, 3).map((h) => (
            <li>
              <b>{h.title} · {h.meta}</b>
              <span>{h.sub}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h2>Design <a href="/creative/">All projects</a></h2>
      <div class="quad">
        {
          shown.map((w) => (
            <a href={w.href} target="_blank" rel="noopener">
              <img src={`/img/work/${w.img}`} alt={w.title} width="808" height="632" loading="lazy" />
            </a>
          ))
        }
      </div>
    </section>
    <section>
      <h2>Notes <a href="/blog/">All articles</a></h2>
      <ul class="list">
        {
          notes.map((p) => (
            <li>
              <a href={postUrl(p)}>
                <b>{p.data.title}</b>
                <span>{p.data.description}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/talks/">
            <b>Talks &amp; decks</b>
            <span>Pulse oximeters, ideation, biomedical innovation and graphic design.</span>
          </a>
        </li>
      </ul>
    </section>
  </div>

  <AuthorStrip />
</Base>
