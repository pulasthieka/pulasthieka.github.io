---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="panel page">
    <h1 class="hl hl--page">
      Page not found <span>› The page you were looking for has moved or never existed</span>
    </h1>
    <div class="actions">
      <a class="btn btn--blue mono" href="/">Front page</a>
      <a class="btn mono" href="/blog/">All articles</a>
    </div>
  </div>
</Base>
