---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="page">
    <div class="eyebrow mono">404</div>
    <h1 class="display">This page took a different path.</h1>
    <p class="lede">The page you were looking for has moved or never existed.</p>
    <div class="actions">
      <a class="btn mono" href="/">← Home</a>
      <a class="btn mono" href="/blog/">Blog →</a>
    </div>
  </section>
</Base>
