---
import Base from '../../layouts/Base.astro';
import { getPosts, postUrl, sectionOf } from '../../lib/posts';

const posts = await getPosts();
import Icon from '../../components/Icon.astro';
import PostMeta from '../../components/PostMeta.astro';
import Cover from '../../components/Cover.astro';
---
<Base title="Articles" description="Research write-ups, interactive explainers and the odd how-to.">
  <div class="panel page">
    <h1 class="hl hl--page">
      Articles <span>› Research write-ups, interactive explainers, and the how-tos I kept looking up</span>
    </h1>

    <div class="sect">
      <h2>{posts.length} articles <a class="ic" href="/rss.xml"><Icon name="rss" />RSS</a></h2>
      <div style="margin-top:12px">
        {
          posts.map((p) => (
            <a class="item" href={postUrl(p)}>
              <div>
                <span class={`chip mono ${p.data.interactive ? 'chip--k' : ''}`}>{p.data.draft ? 'Draft' : sectionOf(p)}</span>
                <h2>
                  {p.data.title} <span>› {p.data.description}</span>
                </h2>
                <div class="meta mono">
                  <PostMeta post={p} />
                </div>
              </div>
              <Cover post={p} thumb lazy />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
