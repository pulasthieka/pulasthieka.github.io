---
import Base from '../../layouts/Base.astro';
import { getPosts, postUrl, dayDate, sectionOf, lengthOf } from '../../lib/posts';

const posts = await getPosts();
---
<Base title="Articles" description="Research notes, proposals, interactive explainers and the occasional how-to.">
  <div class="panel page">
    <h1 class="hl hl--page">
      Articles <span>› Research proposals and reviews, interactive explainers, and the practical notes I kept returning to</span>
    </h1>

    <div class="sect">
      <h2>{posts.length} articles <a href="/rss.xml">RSS</a></h2>
      <div style="margin-top:12px">
        {
          posts.map((p) => (
            <a class="item" href={postUrl(p)}>
              <div>
                <span class={`chip mono ${p.data.interactive ? 'chip--k' : ''}`}>{p.data.draft ? 'Draft' : sectionOf(p)}</span>
                <h2>
                  {p.data.title} <span>› {p.data.description}</span>
                </h2>
                <div class="meta mono">
                  <time datetime={p.data.date.toISOString().slice(0, 10)}>{dayDate(p.data.date)}</time>
                  <span>{lengthOf(p)}</span>
                </div>
              </div>
              <img src={`/covers/${p.id}-thumb.svg`} alt="" width="1600" height="900" loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
