---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { site } from '../../../data/site';
import { getPosts, postUrl, sectionOf } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { year: String(post.data.date.getUTCFullYear()), slug: post.id },
    // posts are newest first: the one before is newer, the one after is older
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const interactive = post.data.interactive && `/interactive/${post.data.interactive}/index.html`;
import Icon from '../../../components/Icon.astro';
import PostMeta from '../../../components/PostMeta.astro';
import Cover from '../../../components/Cover.astro';
import { Image } from 'astro:assets';
---
<Base title={post.data.title} description={post.data.description}>
  <article class="panel article">
    <header class="article__head">
      <a class="back mono ic" href="/blog/"><Icon name="arrow-left" />All articles</a>
      <h1 class="hl">
        {post.data.title} <span>› {post.data.description}</span>
      </h1>
      <p class="meta mono">
        <a class="ic" href="/about/"><Icon name="user" />{site.name}</a>
        <PostMeta post={post} long />
        <span>{sectionOf(post)}</span>
      </p>
    </header>

    {
      interactive ? (
        <div class="embed">
          <iframe src={interactive} title={post.data.title} allow="clipboard-write" />
          <div class="embed__bar mono">
            <span>Try it: search, pick a symbol, open any equation</span>
            <a class="ic" href={interactive} target="_blank" rel="noopener"><Icon name="maximize-2" />Open full screen</a>
          </div>
        </div>
      ) : (
        <figure class="article__cover">
          <Cover post={post} />
        </figure>
      )
    }

    <div class="article__body prose">
      <Content />
    </div>

    <footer class="article__foot">
      <div class="byline">
        <Image src="/img/portrait-thumb.svg" alt="" width={800} height={1000} data-portrait="thumb" />
        <p>
          Written by <a href="/about/">{site.name}</a>, {site.byline}.
          Questions or corrections? <a href={`mailto:${site.email}`}>Say hello</a>, or <a href="/rss.xml">follow along by RSS</a>.
        </p>
      </div>
      <nav class="more" aria-label="More articles">
        {
          older && (
            <a href={postUrl(older)}>
              <span class="mono ic"><Icon name="arrow-left" />Older</span>
              <b>{older.data.title}</b>
            </a>
          )
        }
        {
          newer && (
            <a class="more__next" href={postUrl(newer)}>
              <span class="mono ic">Newer<Icon name="arrow-right" /></span>
              <b>{newer.data.title}</b>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>
