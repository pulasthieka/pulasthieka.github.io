---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { site } from '../../../data/site';
import { getPosts, postUrl, longDate, sectionOf, lengthOf } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { year: String(post.data.date.getUTCFullYear()), slug: post.id },
    // posts are newest first: the one before is newer, the one after is older
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const interactive = post.data.interactive && `/interactive/${post.data.interactive}/index.html`;
---
<Base title={post.data.title} description={post.data.description}>
  <article class="panel article">
    <header class="article__head">
      <a class="back mono" href="/blog/">← All articles</a>
      <h1 class="hl">
        {post.data.title} <span>› {post.data.description}</span>
      </h1>
      <p class="meta mono">
        <a href="/about/">{site.name}</a>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{longDate(post.data.date)}</time>
        <span>{sectionOf(post)}</span>
        <span>{lengthOf(post)}</span>
      </p>
    </header>

    {
      interactive ? (
        <div class="embed">
          <iframe src={interactive} title={post.data.title} allow="clipboard-write" />
          <div class="embed__bar mono">
            <span>Interactive: search, pick a symbol, open any equation</span>
            <a href={interactive} target="_blank" rel="noopener">Open full screen ↗</a>
          </div>
        </div>
      ) : (
        <figure class="article__cover">
          <img src={`/covers/${post.id}.svg`} alt="" width="1600" height="900" />
        </figure>
      )
    }

    <div class="article__body prose">
      <Content />
    </div>

    <footer class="article__foot">
      <div class="byline">
        <img src="/img/portrait-thumb.svg" alt="" width="800" height="1000" loading="lazy" />
        <p>
          Written by <a href="/about/">{site.name}</a>, {site.byline}.
          <a href={`mailto:${site.email}`}>Say hello</a> or <a href="/rss.xml">follow by RSS</a>.
        </p>
      </div>
      <nav class="more" aria-label="More articles">
        {
          older && (
            <a href={postUrl(older)}>
              <span class="mono">← Older</span>
              <b>{older.data.title}</b>
            </a>
          )
        }
        {
          newer && (
            <a class="more__next" href={postUrl(newer)}>
              <span class="mono">Newer →</span>
              <b>{newer.data.title}</b>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>
