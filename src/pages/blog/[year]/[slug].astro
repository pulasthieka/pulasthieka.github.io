---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { site } from '../../../data/site';
import { getPosts, postUrl, longDate, readingTime } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { year: String(post.data.date.getUTCFullYear()), slug: post.id },
    // posts are newest first: the one before is newer, the one after is older
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const interactive = post.data.interactive && `/interactive/${post.data.interactive}/index.html`;
---
<Base title={post.data.title} description={post.data.description} accent="blue">
  <article class="page page--narrow">
    <a class="back mono" href="/blog/">← Blog</a>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-dek">{post.data.description}</p>
    <p class="post-meta mono">
      <a href="/about/">{site.name}</a>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{longDate(post.data.date)}</time>
      {post.data.category && <span>{post.data.category}</span>}
      {!interactive && <span>{readingTime(post.body)} min read</span>}
    </p>
    {
      interactive ? (
        <div class="embed">
          <div class="embed__bar mono">
            <span><i></i>Interactive · runs in your browser</span>
            <a href={interactive} target="_blank" rel="noopener">Open full screen ↗</a>
          </div>
          <iframe src={interactive} title={post.data.title} allow="clipboard-write" />
        </div>
      ) : (
        <img class="post-cover" src={`/covers/${post.id}.svg`} alt="" width="1600" height="900" />
      )
    }
    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <div class="byline">
        <img src="/img/portrait-thumb.svg" alt="" width="800" height="1000" loading="lazy" />
        <p>
          Written by <a href="/about/">{site.name}</a>, a biomedical engineer working on biosignals, diagnostics and
          the models that read them. <a href={`mailto:${site.email}`}>Say hello</a> or
          <a href="/rss.xml">follow by RSS</a>.
        </p>
      </div>
      <nav class="post-nav" aria-label="More articles">
        {
          older && (
            <a href={postUrl(older)}>
              <span class="mono">← Older</span>
              <b>{older.data.title}</b>
            </a>
          )
        }
        {
          newer && (
            <a class="post-nav__next" href={postUrl(newer)}>
              <span class="mono">Newer →</span>
              <b>{newer.data.title}</b>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>
